\f0     <h1>
\f2 \uc0\u55357 \u56538 
\f0  \uc0\u1052 \u1086 \u1081  \u1089 \u1088 \u1077 \u1076 \u1085 \u1080 \u1081  \u1073 \u1072 \u1083 \u1083 </h1>
\f1 \

\f0     <div class="subtitle">
\f1 \

\f0         \uc0\u1059 \u1079 \u1085 \u1072 \u1081  \u1089 \u1074 \u1086 \u1081  \u1089 \u1088 \u1077 \u1076 \u1085 \u1080 \u1081  \u1073 \u1072 \u1083 \u1083  \u1080  \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1085 \u1091 \u1078 \u1085 \u1086  \u1087 \u1103 \u1090 \u1105 \u1088 \u1086 \u1082 
\f1 \

\f0     </div>
\f1 \
\

\f0     <label for="subject">\uc0\u1055 \u1088 \u1077 \u1076 \u1084 \u1077 \u1090 </label>
\f1 \

\f0     <input id="subject" type="text" placeholder="\uc0\u1053 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 : \u1052 \u1072 \u1090 \u1077 \u1084 \u1072 \u1090 \u1080 \u1082 \u1072 ">
\f1 \
\

\f0     <label for="grades">\uc0\u1054 \u1094 \u1077 \u1085 \u1082 \u1080 </label>
\f1 \

\f0     <input id="grades" type="text" placeholder="\uc0\u1053 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 : 5, 4, 5, 3, 4">
\f1 \
\

\f0     <button onclick="calculate()">\uc0\u1056 \u1072 \u1089 \u1089 \u1095 \u1080 \u1090 \u1072 \u1090 \u1100 </button>
\f1 \
\

\f0     <div class="result" id="result">
\f1 \
\

\f0         <div id="subjectResult"></div>
\f1 \
\

\f0         <div class="average" id="average"></div>
\f1 \
\

\f0         <div class="message" id="message"></div>
\f1 \
\

\f0     </div>
\f1 \
\

\f0 </div>
\f1 \
\

\f0 <script>
\f1 \
\

\f0 function calculate() \{
\f1 \
\

\f0     const subject = document.getElementById("subject").value;
\f1 \

\f0     const gradesText = document.getElementById("grades").value;
\f1 \
\

\f0     const grades = gradesText
\f1 \
        .split(",")\
        .map(Number)\
        .filter(grade => grade >= 2 && grade <= 5);\
\
    if (grades.length === 0) \{\
        alert("\uc0\u1042 \u1074 \u1077 \u1076 \u1080 \u1090 \u1077  \u1086 \u1094 \u1077 \u1085 \u1082 \u1080  \u1086 \u1090  2 \u1076 \u1086  5.");\
        return;\
    \}\
\
    const sum = grades.reduce((total, grade) => total + grade, 0);\
\
    const average = sum / grades.length;\
\
    document.getElementById("result").style.display = "block";\
\
    document.getElementById("subjectResult").innerHTML =\
        "<h2>" + (subject || "\uc0\u1052 \u1086 \u1081  \u1087 \u1088 \u1077 \u1076 \u1084 \u1077 \u1090 ") + "</h2>";\
\
    document.getElementById("average").textContent =\
        average.toFixed(2);\
\
    if (average >= 4.6) \{\
\
        document.getElementById("message").textContent =\
            "
\f2 \uc0\u55356 \u57225 
\f1  \uc0\u1055 \u1086 \u1079 \u1076 \u1088 \u1072 \u1074 \u1083 \u1103 \u1102 ! \u1057 \u1088 \u1077 \u1076 \u1085 \u1080 \u1081  \u1073 \u1072 \u1083 \u1083  \u1091 \u1078 \u1077  \u1085 \u1072  5.";\
\
    \} else \{\
\
        let numberOfFives = 0;\
        let newAverage = average;\
\
        while (newAverage < 4.6 && numberOfFives < 100) \{\
\
            numberOfFives++;\
\
            newAverage =\
                (sum + numberOfFives * 5) /\
                (grades.length + numberOfFives);\
        \}\
\
        document.getElementById("message").textContent =\
            "
\f2 \uc0\u55356 \u57263 
\f1  \uc0\u1053 \u1091 \u1078 \u1085 \u1086  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1090 \u1100  \u1077 \u1097 \u1105  " +\
            numberOfFives +\
            " \uc0\u1087 \u1103 \u1090 \u1105 \u1088 \u1086 \u1082 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1076 \u1086 \u1089 \u1090 \u1080 \u1095 \u1100  4.6.";\
    \}\
\}\
\
</script>\
